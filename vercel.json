{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "echo 'Static site already built locally — skipping Vercel build.'",
  "installCommand": "echo 'No install needed.'",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/mail",
      "destination": "/api/mail.php"
    },
    {
      "source": "/assets/mail.php",
      "destination": "/api/mail.php"
    },
    {
      "source": "/about",
      "destination": "/about.php"
    },
    {
      "source": "/services",
      "destination": "/services.php"
    },
    {
      "source": "/skills",
      "destination": "/skills.php"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.php"
    },
    {
      "source": "/blog",
      "destination": "/blog.php"
    },
    {
      "source": "/contact",
      "destination": "/contact.php"
    },
    {
      "source": "/article",
      "destination": "/article.php"
    },
    {
      "source": "/portfolio-details",
      "destination": "/portfolio-details.php"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.php"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.php"
    },
    {
      "source": "/terms",
      "destination": "/terms.php"
    },
    {
      "source": "/gmobile",
      "destination": "/gmobile.php"
    },
    {
      "source": "/gpay",
      "destination": "/gpay.php"
    },
    {
      "source": "/gtresearch",
      "destination": "/gtresearch.php"
    },
    {
      "source": "/kd",
      "destination": "/kd.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ]
}